"""In-tree Riviera-PRO toolchain used by this repo's smoke tests.

Registered as `dev_dependency = True` from MODULE.bazel, so downstream
consumers don't inherit it — they author their own `riviera_toolchain`
in their own repo (see `examples/simple/` for a reference).

Relies on Riviera being on PATH wherever the actions run; every tool
binds to the shipped PATH-resolving shim.
"""

load("//riviera:riviera_toolchain.bzl", "riviera_toolchain")

package(default_visibility = ["//visibility:public"])

riviera_toolchain(
    name = "riviera_toolchain_def",
    requires_network = True,
    version = "2025.04",
    vsimsa = "//riviera/private/shims:vsimsa",
)

toolchain(
    name = "riviera_toolchain",
    toolchain = ":riviera_toolchain_def",
    toolchain_type = "//riviera:toolchain_type",
)
