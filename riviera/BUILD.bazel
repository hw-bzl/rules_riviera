load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

# Toolchain type consumed by every native Riviera rule. Downstream users
# register a `riviera_toolchain` bound to this type in their own repo.
# The in-tree `//tests/toolchains:riviera_toolchain` is registered as a
# dev-dependency from our MODULE.bazel so it doesn't leak into consumers.
toolchain_type(name = "toolchain_type")

exports_files([
    "defs.bzl",
    "riviera_library.bzl",
    "riviera_sim_test.bzl",
    "riviera_toolchain.bzl",
])

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    deps = [
        "//riviera/private:bzl_lib",
    ],
)
